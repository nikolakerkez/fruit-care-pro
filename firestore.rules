rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // exists() guards keep these from erroring when the referenced doc is
    // missing (e.g. a user doc already deleted mid-flow, or a chat that is
    // being created in the same transaction).
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function isChatMember(chatId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }

    // ── users ───────────────────────────────────────────────────────────
    // Readable by any signed-in user: names/avatars are shown across chats,
    // read receipts, and chat lists for every participant, not just admin.
    match /users/{userId} {
      allow read: if isSignedIn();

      // Accounts are created server-side only (Cloud Function, Admin SDK),
      // never directly by a client.
      allow create: if false;

      allow update: if isAdmin() ||
        (
          isSignedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fcmToken', 'lastTokenUpdate', 'badgeCount', 'chatBadgeCounts',
            'activeChatId', 'isPasswordChangeNeeded', 'passwordLastChanged',
            'imageUrl', 'thumbUrl', 'imagePath', 'thumbPath', 'localImagePath',
            'city', 'phone',
          ])
        );

      // Self-delete only (account deletion flow); admin has no "delete other
      // user" feature in the app today.
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ── fruit_types (master list of "voćne vrste") ─────────────────────
    match /fruit_types/{fruitTypeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── user_2_fruittypes (which users grow which fruit types) ─────────
    // Assignment is admin-managed. A user may only remove their own links
    // (part of the in-app "delete account" flow).
    match /user_2_fruittypes/{assocId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── advertisements & categories ─────────────────────────────────────
    match /advertisement_categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /advertisements/{adId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── chats ────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      // resource == null lets a transaction check whether a chat exists
      // (e.g. admin editing/deleting a fruit type that has no chat yet).
      allow read: if isSignedIn() &&
        (resource == null || request.auth.uid in resource.data.memberIds);

      // Starting a new chat: you must include yourself as a member.
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberIds;

      // Any member can update chat metadata (lastMessage, typing, etc.).
      // Membership itself is admin-managed; a member may only remove
      // themselves (delete-account flow).
      allow update: if isAdmin() ||
        (
          isSignedIn() && request.auth.uid in resource.data.memberIds &&
          (
            request.resource.data.memberIds == resource.data.memberIds ||
            request.resource.data.memberIds.toSet() ==
              resource.data.memberIds.toSet().difference([request.auth.uid].toSet())
          )
        );

      // Admin can delete any chat (deleting a fruit type). A member can
      // delete their own private (non-group) chat (delete-account flow).
      allow delete: if isAdmin() ||
        (
          isSignedIn() && request.auth.uid in resource.data.memberIds &&
          resource.data.get('type', '') != 'group' &&
          resource.data.get('isGroup', false) != true
        );

      match /members/{memberId} {
        // Sending a message fans out lastMessage/unreadCount updates to
        // every member doc in the chat, so any member needs access to all
        // member subdocuments here, not just their own. Admin is allowed
        // explicitly so creating a fruit type can create the chat and its
        // first member doc in one transaction (the chat does not exist yet
        // when the rule is evaluated).
        allow read, write: if isAdmin() || isChatMember(chatId);
      }

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);

        allow create: if isChatMember(chatId) &&
          request.resource.data.senderId == request.auth.uid;

        // The sender can freely edit/delete their own message (also covers
        // background image-upload progress updates). Other members may only
        // touch read-receipt / hidden-for-me fields, never message content.
        allow update: if isChatMember(chatId) &&
          (
            resource.data.senderId == request.auth.uid ||
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['readBy', 'deliveredTo', 'hiddenFor'])
          );

        allow delete: if false;
      }
    }
  }
}
